# Copy to .env (never commit .env). Values here are non-secret local defaults.
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
DATABASE_URL=pglite://./var/db
SESSION_SECRET=change-me-generate-32-random-bytes
STORAGE_DIR=./var/storage
# Key for the local secret store (integration credentials). Required when NODE_ENV=production; otherwise derived from SESSION_SECRET.
# SECRET_STORE_KEY=change-me-generate-32-random-bytes-different-from-session
AI_PROVIDER=mock
IDENTITY_PROVIDER=mock
DEFAULT_TENANT_SLUG=meridian-demo
API_URL=http://localhost:4000
# SEED_PASSWORD=   (leave unset to use the documented demo password)
