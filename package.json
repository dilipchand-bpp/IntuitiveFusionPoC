{
  "name": "intuitive-fusion-poc",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @if/shared && concurrently -n api,web -c blue,magenta \"npm run dev -w @if/api\" \"npm run dev -w @if/web\"",
    "build": "npm run build -w @if/shared && npm run build -w @if/api && npm run build -w @if/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build -w @if/shared && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "audit:ci": "npm audit --audit-level=high",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "husky",
    "db:reset": "node scripts/ensure-env.mjs && npm run db:reset -w @if/api && npm run db:seed -w @if/api",
    "db:seed": "node scripts/ensure-env.mjs && npm run db:seed -w @if/api",
    "predev": "node scripts/ensure-env.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,css,yml}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
